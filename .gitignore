chronicle-server
*.db
*.db-journal
*.db-wal

# Real env files anywhere in the repo (deploy/, or a future one) must never
# be committed -- only the checked-in .env.example templates are tracked.
.env
**/.env

# Frontend dependencies. Node modules remain ignored.
frontend/node_modules/

# Plugin build toolkit dependencies -- installed in the Docker toolkit stage
# (and locally only for verification); only package.json + package-lock.json
# are tracked. See Dockerfile's plugin-toolkit stage.
plugin-toolkit/node_modules/

# Formal-suite run output (regenerated each run; may contain database snapshots).
tests/formal/artifacts/*
!tests/formal/artifacts/.gitkeep
tests/formal/node_modules/

# Browser (Playwright) tier -- same pattern as the formal suite above.
tests/formal/browser/artifacts/*
!tests/formal/browser/artifacts/.gitkeep
tests/formal/browser/node_modules/
tests/formal/browser/test-results/
