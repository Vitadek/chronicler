# Generate with: openssl rand -hex 32
CHRONICLE_TOKEN=replace-with-a-random-token
CHRONICLE_PORT=3000

# Optional S3 replica. Leave STORAGE_REPLICA=none for SQLite-only use.
STORAGE_REPLICA=none
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PREFIX=chronicle
S3_FORCE_PATH_STYLE=false
S3_ALLOW_INSECURE_HTTP=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
