# Full variable reference: deploy/ENVIRONMENT.md

# --- Core server ---
CHRONICLE_PORT=3000
# NODE_ENV=production is set directly in compose.yml, not here.
DATA_DIR=/data
LOCAL_ADMIN=false

# --- Auth ---
# AUTH_MODE selects one of: none | token | forward | oidc.
AUTH_MODE=token
ALLOW_INSECURE_NO_AUTH=false

# AUTH_MODE=token
# Generate with: openssl rand -hex 32
CHRONICLE_TOKEN=replace-with-a-random-token

# AUTH_MODE=forward -- only read when AUTH_MODE=forward. Leave blank otherwise.
# AUTH_FORWARD_HEADER_USER=Remote-User
# AUTH_FORWARD_HEADER_EMAIL=Remote-Email
# AUTH_FORWARD_HEADER_NAME=Remote-Name
# AUTH_FORWARD_HEADER_GROUPS=Remote-Groups
# AUTH_FORWARD_TRUSTED_PROXIES=loopback,linklocal,uniquelocal
# AUTH_FORWARD_SECRET_HEADER=
# AUTH_FORWARD_SECRET=
# AUTH_FORWARD_ADMIN_GROUP=

# AUTH_MODE=oidc -- only read when AUTH_MODE=oidc. Leave blank otherwise.
# AUTH_OIDC_ISSUER_URL=
# AUTH_OIDC_CLIENT_ID=
# AUTH_OIDC_CLIENT_SECRET=
# AUTH_OIDC_REDIRECT_URI=
# AUTH_OIDC_SCOPES=openid profile email
# AUTH_OIDC_POST_LOGOUT_REDIRECT_URI=
# AUTH_OIDC_TOKEN_AUTH_METHOD=auto

# --- Storage replica ---
# STORAGE_REPLICA selects one of: none | nextcloud | s3. SQLite is always
# authoritative -- a replica is an async disaster-recovery copy, not primary storage.
STORAGE_REPLICA=none
STORAGE_RETRY_INTERVAL_MS=30000
STORAGE_MAX_ATTEMPTS=10

# STORAGE_REPLICA=nextcloud -- only read when STORAGE_REPLICA=nextcloud.
# NEXTCLOUD_URL=
# NEXTCLOUD_ALLOW_INSECURE_HTTP=false
# NC_USER=
# NC_PASS=
# NC_DIR=Chronicle_Storage
# NEXTCLOUD_CLIENT_ID=
# NEXTCLOUD_CLIENT_SECRET=
# NEXTCLOUD_REDIRECT_URI=

# STORAGE_REPLICA=s3
S3_BUCKET=
S3_REGION=us-east-1
S3_ENDPOINT=
S3_PREFIX=chronicle
S3_FORCE_PATH_STYLE=false
S3_ALLOW_INSECURE_HTTP=false
S3_SERVER_SIDE_ENCRYPTION=
# S3_KMS_KEY_ID=          # only if S3_SERVER_SIDE_ENCRYPTION=aws:kms
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Retired -- do not set. Boot fails if either is present. ---
# NEXTCLOUD_MIRROR=
# NEXTCLOUD_MIRROR_ROOT=

# --- Deprecated but still accepted -- prefer STORAGE_REPLICA above; don't set both. ---
# STORAGE_PROVIDER=
